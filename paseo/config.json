{
  "daemon": {
    "mcp": {
      "injectIntoAgents": true
    },
    "browserTools": {
      "enabled": true
    },
    "enableTerminalAgentHooks": true,
    "terminalProfiles": [
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      },
      {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "--prompt={{{prompt}}}"
        ],
        "icon": "opencode"
      },
      {
        "id": "omp",
        "name": "OMP",
        "command": "omp",
        "args": [
          "--auto-approve",
          "{{{prompt}}}"
        ]
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "pluginsEnabled": true,
  "version": 1,
  "agents": {
    "providers": {
      "copilot": {
        "enabled": false
      },
      "pi": {
        "enabled": false
      },
      "omp": {
        "enabled": true
      }
    }
  }
}
